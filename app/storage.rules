rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photo frames + taste-feed images — each user can only write into their
    // own uploads/{uid}/ folder, but images can be read by anyone with the
    // download URL (needed since <img> tags fetch them directly).
    match /uploads/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
