rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's own progress doc — only they can read/write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Flock membership rows are denormalized streak/best for the leaderboard.
    // Anyone signed in can read a flock (you need the code to know it exists);
    // a member can only write their own row.
    match /flocks/{code}/members/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Pokes are write-once nudges; anyone signed in can send one, only the
    // sender or recipient can read it.
    match /pokes/{pokeId} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update, delete: if false;
    }
  }
}
