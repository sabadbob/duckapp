# Copy this file to .env.local (git-ignored) and fill in real values.
# See README.md for step-by-step setup of each service.

# Firebase (Auth + Firestore + Storage) — Firebase console > Project settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps Platform — Places API (New), billing-enabled project.
# Restrict this key to Places API + your deployed domain in Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Google Sheets API — can reuse the same key as above if "Google Sheets API"
# is also enabled on that Cloud project, or use a separate restricted key.
VITE_GOOGLE_API_KEY=
